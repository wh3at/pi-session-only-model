{
  "name": "pi-session-only-model",
  "version": "0.1.3",
  "description": "Add /session-only-model for temporary Pi model selection without changing normal /model behavior or settings defaults.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh3at/pi-session-only-model.git"
  },
  "bugs": {
    "url": "https://github.com/wh3at/pi-session-only-model/issues"
  },
  "homepage": "https://github.com/wh3at/pi-session-only-model#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "guard.ts",
    "command.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package:verify": "node --experimental-strip-types scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "24.12.0",
    "typescript": "5.9.3"
  }
}
